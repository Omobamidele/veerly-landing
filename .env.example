# Everything is optional. With nothing set, the site previews locally and saves signups to data/waitlist.json.
# Copy to .env.local and fill in what you need. Never commit real keys.

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=                 # e.g. https://your-domain (used for canonical, OG, Paystack callback)
NEXT_PUBLIC_CONTACT_EMAIL=            # shows "Contact" in the footer when set
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=     # shows "Join the WhatsApp channel" when set

# ---------- Launch ----------
NEXT_PUBLIC_LAUNCH_AT=2026-12-01T09:00:00+01:00   # countdown target (shown in WAT)
NEXT_PUBLIC_LAUNCH_STATE=             # "prelaunch" | "launched" to force a state; empty = follow the clock
NEXT_PUBLIC_COHORT_LABEL=January 2027
NEXT_PUBLIC_COHORT_START_AT=          # ISO date-time; enables the cohort calendar invite on /welcome
NEXT_PUBLIC_ASSESSMENT_URL=           # career assessment link shown after payment
NEXT_PUBLIC_NOTION_ACCESS_URL=        # Notion access instructions link shown after payment

# ---------- Primary store ----------
WAITLIST_STORE=                       # "file" (default locally) | "upstash" (use on Vercel)
WAITLIST_FILE=data/waitlist.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Email: Brevo ----------
BREVO_API_KEY=
BREVO_LIST_ID=                        # list for email-consented contacts
BREVO_WHATSAPP_LIST_ID=               # list for WhatsApp-consented contacts
BREVO_PAID_LIST_ID=                   # list for buyers
BREVO_WELCOME_TEMPLATE_ID=            # optional welcome email on signup (needs email consent)
BREVO_DOI_TEMPLATE_ID=                # optional double opt-in instead of direct add
BREVO_DOI_REDIRECT_URL=               # page people land on after confirming DOI
BREVO_PAID_TEMPLATE_ID=               # transactional "payment confirmed" onboarding email

# ---------- Other mirrors (optional) ----------
NOTION_TOKEN=
NOTION_WAITLIST_DATABASE_ID=
WAITLIST_WEBHOOK_URL=                 # Google Sheets (Apps Script), Zapier, Make, n8n...
WAITLIST_WEBHOOK_SECRET=              # signs webhook bodies (X-Veerly-Signature, HMAC-SHA256)

# ---------- Payments: Paystack ----------
PAYSTACK_SECRET_KEY=                  # sk_test_... first, sk_live_... at launch. Unset = "Payments open at launch"
PAYSTACK_WEBHOOK_SECRET=              # whsec_... signing secret (Paystack-Signature header)
PAYSTACK_AMOUNT_NGN=10000
PAYSTACK_ENABLE_USD=false             # true only once Paystack enables USD for your business
PAYSTACK_AMOUNT_USD=7.99

# ---------- WhatsApp Cloud API (used only by scripts/notify-launch.ts) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_LAUNCH_TEMPLATE=veerly_launch
WHATSAPP_REMINDER_TEMPLATE=veerly_launch_reminder
WHATSAPP_TEMPLATE_LANG=en

# ---------- Admin ----------
ADMIN_PASSWORD=                       # enables /admin/waitlist (basic auth, any username). Unset = 404
